# Prisma (use Session pooler URL from Supabase if direct host is not IPv4-compatible)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?schema=public"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# Railway socket server only
CORS_ORIGIN="http://localhost:3000,https://your-app.vercel.app"

# Next.js + Supabase client — copy to .env.local
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
